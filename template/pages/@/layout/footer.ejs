<%
// Rodapé da Ladh Home, escuro no padrão do topo: voltar ao início, marca com WhatsApp,
// colunas Ajuda / Institucional / Departamentos / Atendimento, pagamentos, selos e linha legal.
// No celular as colunas de links viram sanfona (<details>, fechadas em custom-js/pages.js).
const footer = _.cms('footer') || {}
const contacts = _.cms('contacts') || {}
const logo = _.settings.logo
const icon = (name, size) => include('@/layout/inc/lh-icon', { name, size: size || 20 })

// páginas de ajuda ao cliente; as demais páginas do CMS ficam em "Institucional"
const helpSlugs = [
  'entregas-no-mesmo-dia', 'entrega', 'pagamentos', 'faq',
  'trocas', 'arrependimento-de-compra', 'politicas-de-reembolso'
]
const pages = (_.cms('pages') || []).map(slug => ({ slug, title: (_.cms(`pages/${slug}`) || {}).title || slug }))
const helpPages = helpSlugs.map(slug => pages.find(page => page.slug === slug)).filter(Boolean)
const otherPages = pages.filter(({ slug }) => !helpSlugs.includes(slug))
const departments = _.categories.filter(({ parent }) => !parent)

const wppNumber = (contacts.whatsapp || '').replace(/\D/g, '')
// redes sociais (sem repetir o mesmo link, ex.: YouTube cadastrado com o link do Instagram)
const networks = []
;[['instagram', 'Instagram'], ['facebook', 'Facebook'], ['youtube', 'YouTube'], ['tiktok', 'TikTok']].forEach(([network, label]) => {
  const url = contacts[network]
  if (url && !networks.find(item => item.url === url)) {
    networks.push({ network, label, url })
  }
})
const year = new Date().getFullYear()
%>

<footer class="footer lh-foot">
  <button id="go-to-top" class="lh-foot__top" type="button">
    <%- await icon('chevron-up', 18) %>
    Voltar ao início
  </button>

  <div class="lh-foot__main">
    <div class="container">
      <div class="lh-foot__grid">
        <div class="lh-foot__brand">
          <% if (logo) { %>
            <img src="<%= logo %>" alt="<%= _.store.name %>" width="200" height="44" loading="lazy">
          <% } else { %>
            <strong class="lh-foot__name"><%= _.store.name %></strong>
          <% } %>
          <p>Utilidades para casa, cozinha e construção com entrega no mesmo dia em São Paulo.</p>
          <% if (wppNumber) { %>
            <a
              href="javascript:;"
              target="_blank"
              rel="noopener"
              class="whatsapp-link lh-foot__wpp"
              data-tel="<%= wppNumber %>"
            >
              <%- await icon('brand-whatsapp', 20) %>
              Falar no WhatsApp
            </a>
          <% } %>
          <% if (footer.contacts && footer.contacts.socials && networks.length) { %>
            <div class="lh-foot__social">
              <% for (const { network, label, url } of networks) { %>
                <a href="<%= url %>" target="_blank" rel="noopener" aria-label="<%= label %>">
                  <%- await icon(`brand-${network}`, 20) %>
                </a>
              <% } %>
            </div>
          <% } %>
        </div>

        <% if (helpPages.length) { %>
          <details class="lh-foot__col" open>
            <summary>Ajuda <%- await icon('chevron-down', 18) %></summary>
            <ul>
              <% helpPages.forEach(({ slug, title }) => { %>
                <li><a href="/pages/<%= slug %>"><%= title %></a></li>
              <% }) %>
            </ul>
          </details>
        <% } %>

        <% if (otherPages.length) { %>
          <details class="lh-foot__col" open>
            <summary>Institucional <%- await icon('chevron-down', 18) %></summary>
            <ul>
              <% otherPages.forEach(({ slug, title }) => { %>
                <li><a href="/pages/<%= slug %>"><%= title %></a></li>
              <% }) %>
            </ul>
          </details>
        <% } %>

        <% if (departments.length) { %>
          <details class="lh-foot__col" open>
            <summary>Departamentos <%- await icon('chevron-down', 18) %></summary>
            <ul>
              <% departments.forEach(({ name, slug }) => { %>
                <li><a href="/<%= slug %>"><%= name %></a></li>
              <% }) %>
            </ul>
          </details>
        <% } %>

        <div class="lh-foot__contact">
          <div class="lh-foot__title">Atendimento</div>
          <% if (contacts.phone) { %>
            <a href="tel:+55<%= contacts.phone.replace(/\D/g, '') %>"><%- await icon('phone') %> <%= contacts.phone %></a>
          <% } %>
          <% if (contacts.email) { %>
            <a href="mailto:<%= contacts.email %>"><%- await icon('mail') %> <%= contacts.email %></a>
          <% } %>
          <a href="/pages/entregas-no-mesmo-dia"><%- await icon('clock') %> Pedidos até 12h55 chegam hoje</a>
          <% if (contacts.address) { %>
            <address><%- await icon('map-pin') %> <span><%= contacts.address %></span></address>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="lh-foot__trust">
    <div class="container">
      <div class="lh-foot__pay">
        <small>Formas de pagamento</small>
        <div class="footer__payment-methods">
          <% Object.keys(footer.payment_methods || {}).forEach(method => { %>
            <% if (footer.payment_methods[method]) { %>
              <span class="lh-foot__pay-item"><i class="pay-icon pay-icon--<%= method %>"></i></span>
            <% } %>
          <% }) %>
        </div>
      </div>
      <div class="lh-foot__seals">
        <span class="lh-foot__seal"><%- await icon('lock') %> <b>Site seguro</b> <small>Certificado SSL</small></span>
        <span class="lh-foot__seal"><%- await icon('shield-check') %> <b>Compra garantida</b> <small>Troca em 7 dias</small></span>
      </div>
    </div>
  </div>

  <div class="lh-foot__legal">
    <div class="container">
      <span class="lh-foot__copy">
        <%= footer.credits || `© ${year} ${_.store.name} · CNPJ ${contacts.doc_number || ''} · ${contacts.address || ''}` %>
      </span>
      <span class="lh-foot__credits">
        <a class="lh-foot__dev" href="https://orbara.com.br" target="_blank" rel="noopener" title="Layout desenvolvido por Orbara">
          <small>Layout por</small>
          <svg class="lh-orbara" width="22" height="22" viewBox="-4 -4 32 32" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10.5" stroke="#ffffff" stroke-width="1.5" />
            <g class="lh-orbara__orbit">
              <circle cx="19.5" cy="4.5" r="3" fill="#ff5d00" />
              <circle cx="19.5" cy="4.5" r="1.5" fill="#ffaa60" />
            </g>
          </svg>
          <b>Orbara</b>
        </a>
        <a class="lh-foot__platform" href="https://e-com.plus" target="_blank" rel="noopener" title="Loja na plataforma E-Com Plus">
          <img
            src="https://ecom.nyc3.cdn.digitaloceanspaces.com/storefront/ecom-credits-white.png"
            alt="E-Com Plus"
            width="94"
            height="15"
            loading="lazy"
          >
        </a>
      </span>
    </div>
  </div>
</footer>
