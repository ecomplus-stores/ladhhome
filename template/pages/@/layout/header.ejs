<%
// load header options and contacts from content
const header = _.cms('header') || {}
const contacts = _.cms('contacts') || {}
const icon = (name, size) => include('@/layout/inc/lh-icon', { name, size })

// list featured categories
let categories = []
if (header.categories_list) {
  if (header.categories_list.featured.length) {
    // selected categories/collections/brands
    categories = header.categories_list.featured.map(pathAndName => {
      const [path, name] = pathAndName.split('?')
      return { slug: path.slice(1), name }
    })
  }
  if (header.categories_list.random) {
    // add up to `random` main categories
    const mainCategories = _.categories.filter(({ parent }) => !parent || !parent.slug)
    for (let i = 0; i < header.categories_list.random && i < mainCategories.length; i++) {
      if (!categories.find(({ slug }) => mainCategories[i].slug === slug)) {
        categories.push(mainCategories[i])
      }
    }
  }
}
// "Ofertas" has its own highlighted link, so it leaves the regular list
const offersSlug = 'ofertas'
categories = categories.filter(({ slug }) => slug !== offersSlug)
const hasMegamenu = header.desktop_megamenu
const isAlphabeticalOrderSubmenu = header.alphabetical_order_submenu
const byName = (a, b) => b.name > a.name ? -1 : 1

// departments panel: main categories, each with its subcategories
const deptIcons = {
  'casa-e-construcao': 'home',
  cozinha: 'tools-kitchen-2',
  ferramentas: 'tool',
  'cuidados-da-casa': 'spray',
  eletronicos: 'device-speaker',
  'papelaria-e-armarinho': 'scissors',
  climatizacao: 'snowflake'
}
const departments = _.categories
  .filter(({ parent, slug }) => (!parent || !parent.slug) && slug !== offersSlug)
  .map(category => ({
    ...category,
    children: _.categories.filter(({ parent }) => parent && parent.slug === category.slug).sort(byName)
  }))
const whatsapp = contacts.whatsapp ? contacts.whatsapp.replace(/\D/g, '') : ''
%>

<div id="overlay" class="fade"></div>

<header class="header lh-header" id="header">
  <div class="lh-top">
    <div class="lh-top__inner">
      <button
        class="lh-act lh-toggler d-lg-none"
        type="button"
        onclick="toggleSidenav()"
        aria-label="Abrir menu de departamentos"
      >
        <%- await icon('menu-2', 26) %>
      </button>

      <a href="/" class="lh-logo" aria-label="<%= _.settings.name %>">
        <%- await include('@/layout/inc/logo', { _ }) %>
      </a>

      <button type="button" class="lh-act lh-cep-btn d-none d-lg-flex" data-lh-cep aria-haspopup="dialog">
        <%- await icon('map-pin', 22) %>
        <span><small>Entregar em</small><b data-lh-cep-label>Informe seu CEP</b></span>
      </button>

      <% if (header.search_input) { %>
        <form class="lh-search" id="search-form" action="/search" method="get" role="search">
          <input
            type="search"
            name="term"
            placeholder="cadeado Tetra, resistência, potes…"
            aria-label="<%= _.dictionary('searchProducts') %>"
            class="lh-search__input"
            id="search-input"
            autocomplete="off"
          >
          <button type="button" class="lh-search__mic" id="lh-mic" aria-label="Buscar por voz" hidden>
            <%- await icon('microphone', 21) %>
          </button>
          <button type="submit" class="lh-search__go" aria-label="<%= _.dictionary('searchProducts') %>">
            <%- await icon('search', 22) %>
          </button>
          <div id="instant-search">
            <!--
              `InstantSearch` should be open on input focus:
              https://developers.e-com.plus/storefront/@ecomplus/storefront-components/docs/InstantSearch.html
            -->
          </div>
        </form>
        <% if (_.settings.domain) { %>
          <script type="application/ld+json"><%-
            JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'WebSite',
              url: `https://${_.settings.domain}/`,
              potentialAction: {
                '@type': 'SearchAction',
                target: `https://${_.settings.domain}/search?term={search_term_string}`,
                'query-input': 'required name=search_term_string'
              }
            })
          %></script>
        <% } %>
      <% } %>

      <% if (whatsapp) { %>
        <a
          class="lh-act lh-whatsapp d-none d-xl-flex"
          href="https://wa.me/55<%= whatsapp %>"
          target="_blank"
          rel="noopener"
        >
          <%- await icon('brand-whatsapp', 24) %>
          <span><small>Atendimento</small><b>WhatsApp</b></span>
        </a>
      <% } %>

      <a
        id="user-button"
        class="lh-act"
        role="button"
        href="/app/#/account/"
        title="<%= _.dictionary('myAccount') %>"
      >
        <%- await icon('user', 24) %>
        <span class="d-none d-lg-block"><small>Olá, entre</small><b>Minha conta</b></span>
      </a>

      <a class="lh-act d-none d-lg-flex" href="/app/#/account/orders">
        <%- await icon('package', 24) %>
        <span><small>Devoluções</small><b>e pedidos</b></span>
      </a>

      <a
        id="cart-button"
        class="lh-act lh-cart"
        role="button"
        href="/app/#/cart"
        title="<%= _.dictionary('openCart') %>"
      >
        <%- await icon('basket', 26) %>
        <span id="cart-count" class="badge badge-primary"></span>
        <b class="d-none d-lg-inline">Carrinho</b>
      </a>

      <div id="login-modal">
        <!--
          `LoginModal` should be rendered here:
          https://developers.e-com.plus/storefront/@ecomplus/storefront-components/docs/LoginModal.html
        -->
      </div>
      <div id="cart-quickview">
        <!--
          `CartQuickview` should be rendered here:
          https://developers.e-com.plus/storefront/@ecomplus/storefront-components/docs/CartQuickview.html
        -->
      </div>
    </div>
  </div>

  <nav class="lh-menu" aria-label="Departamentos e categorias">
    <div class="lh-menu__inner">
      <a
        href="javascript:;"
        class="lh-menu__dept"
        id="cd-all"
        onmouseover="window.innerWidth >= 992 && toggleSubmenu('all', this)"
        onclick="window.innerWidth >= 992 ? toggleSubmenu('all', this) : toggleSidenav()"
      >
        <%- await icon('layout-grid', 18) %> Departamentos <%- await icon('chevron-down', 15) %>
      </a>
      <a href="/<%= offersSlug %>" class="lh-menu__hot">
        <%- await icon('flame', 18) %> Ofertas
      </a>
      <span class="lh-menu__sep" aria-hidden="true"></span>

      <% for (const { slug, name, _id } of categories) { %>
        <div class="lh-menu__item">
          <a
            href="/<%= slug %>"
            class="lh-menu__link"
            id="cd-<%= _id %>"
            <%- hasMegamenu ? `onmouseover="toggleSubmenu('${slug}', this)"` : '' %>
          >
            <%= name %>
          </a>
          <% if (slug && hasMegamenu) {
            const subcategories = _.categories.filter(({ parent }) => parent && parent.slug === slug)
            if (isAlphabeticalOrderSubmenu) subcategories.sort(byName)
            if (subcategories.length) { %>
              <nav class="header__submenu lh-submenu" id="<%= `s-${slug.replace(/\//g, '_')}` %>">
                <% subcategories.forEach(subcategory => { %>
                  <div>
                    <a id="sd-<%= subcategory._id %>" href="/<%= subcategory.slug %>"><%= subcategory.name %></a>
                    <% _.categories
                      .filter(({ parent }) => parent && parent.slug === subcategory.slug)
                      .forEach(thirdCategory => { %>
                        <a id="td-<%= thirdCategory._id %>" class="header__submenu-subcategory" href="/<%= thirdCategory.slug %>">
                          <%= thirdCategory.name %>
                        </a>
                    <% }) %>
                  </div>
                <% }) %>
              </nav>
            <% } %>
          <% } %>
        </div>
      <% } %>

      <a href="/pages/entregas-no-mesmo-dia" class="lh-menu__right d-none d-xl-flex">
        <%- await icon('truck-delivery', 18) %> Receba hoje em São Paulo
      </a>
    </div>

    <div class="lh-dept" id="s-all">
      <ul class="lh-dept__list">
        <% for (const [i, dept] of departments.entries()) { %>
          <li>
            <a
              href="/<%= dept.slug %>"
              class="lh-dept__item<%= i === 0 ? ' is-active' : '' %>"
              data-lh-dept="<%= dept.slug %>"
            >
              <%- await icon(deptIcons[dept.slug] || 'chevron-right', 19) %>
              <span><%= dept.name %></span>
              <%- await icon('chevron-right', 15) %>
            </a>
          </li>
        <% } %>
      </ul>
      <div class="lh-dept__panels">
        <% departments.forEach((dept, i) => { %>
          <div class="lh-dept__panel<%= i === 0 ? ' is-active' : '' %>" data-lh-panel="<%= dept.slug %>">
            <h5><%= dept.name %></h5>
            <div class="lh-dept__links">
              <% dept.children.forEach(child => { %>
                <a href="/<%= child.slug %>"><%= child.name %></a>
              <% }) %>
            </div>
            <a class="lh-dept__all" href="/<%= dept.slug %>">Ver tudo em <%= dept.name %></a>
          </div>
        <% }) %>
      </div>
      <a class="lh-dept__promo" href="/<%= offersSlug %>">
        <small><%- await icon('flame', 14) %> Ofertas</small>
        <b>Ofertas da semana</b>
        <span>Entrega no mesmo dia em SP e 10% off no Pix</span>
        <u>Ver ofertas</u>
      </a>
    </div>
  </nav>

  <button type="button" class="lh-cep-strip d-lg-none" data-lh-cep aria-haspopup="dialog">
    <%- await icon('map-pin', 17) %>
    <span>Entregar em: <b data-lh-cep-label>informe seu CEP</b></span>
    <%- await icon('chevron-right', 16) %>
  </button>

  <div class="lh-cep-pop" id="lh-cep-pop" role="dialog" aria-label="Informe seu CEP" hidden>
    <form class="lh-cep-pop__form" id="lh-cep-form">
      <label for="lh-cep-input">Informe seu CEP para ver prazos e frete</label>
      <div class="lh-cep-pop__row">
        <input id="lh-cep-input" inputmode="numeric" autocomplete="postal-code" placeholder="00000-000" maxlength="9">
        <button type="submit">Salvar</button>
      </div>
      <a href="/pages/entregas-no-mesmo-dia">Ver regiões com entrega no mesmo dia</a>
    </form>
    <button type="button" class="lh-cep-pop__close" aria-label="Fechar"><%- await icon('x', 18) %></button>
  </div>
</header>

<% if (header.popup) { %>
  <div class="modal fade" id="popup-modal" tabindex="-1" role="dialog" aria-labelledby="modal-popup" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <button type="button" id="close-modal-popup" class="close" data-dismiss="modal" aria-label="Close" style="position: absolute; right: 10px; top: 10px">
          <span aria-hidden="true">&times;</span>
        </button>
        <img src="<%- header.popup %>" style="max-width: 100%">
      </div>
    </div>
  </div>
<% } %>
